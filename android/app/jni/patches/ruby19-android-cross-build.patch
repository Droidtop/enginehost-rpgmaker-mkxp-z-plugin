diff --git a/configure.in b/configure.in
index 1cd2c40..f4830c8 100644
--- a/configure.in
+++ b/configure.in
@@ -2195,1 +2195,7 @@
+  AS_CASE(["$target_os"],
+    [*android*|*androideabi*], [
+      LIBRUBY_SO='lib$(RUBY_SO_NAME).so'
+      LIBRUBY_ALIASES=''
